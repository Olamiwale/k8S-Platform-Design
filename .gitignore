
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan
*tfplan*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive tfvars files (uncomment if needed)
# *.tfvars
# *.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc


